<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.admin.mapper.SysUserRoleMapper">    
    <select id="selectGrantRoles" resultType="com.pig4cloud.pig.admin.api.entity.SysRole">
        SELECT
            r.role_id,
            r.role_code,
            r.role_name
        FROM
            sys_user_role ur
            INNER JOIN sys_role r ON ur.role_id = r.role_id 
        WHERE
            r.is_del = 'NO'
            AND ur.user_id = #{userId}
    </select>
</mapper>
