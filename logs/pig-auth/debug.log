# 数据源
spring:
  freemarker:
    allow-request-override: false
    allow-session-override: false
    cache: true
    charset: UTF-8
    check-template-location: true
    content-type: text/html
    enabled: true
    request-context-attribute: request
    expose-request-attributes: false
    expose-session-attributes: false
    expose-spring-macro-helpers: true
    prefer-file-system-access: true
    suffix: .ftl
    template-loader-path: classpath:/templates/


security:
  encode-key: 'thanks,pig4cloud'
  ignore-clients:
    - test
    - client
    - open
    - app


pigx-oauth:
  clients:
    - additionalInformation: {}
      authorities: []
      authorizedGrantTypes:
        - password
        - refresh_token
        - authorization_code
        - client_credentials
      autoApproveScopes:
        - 'false'
      clientId: pig
      clientSecret: "{noop}pig"
      registeredRedirectUri:
        - http://localhost:4040/sso1/login
        - http://localhost:4041/sso1/login
        - http://localhost:8080/renren-admin/sys/oauth2-sso
        - http://localhost:8090/sys/oauth2-sso
      resourceIds: []
      scope:
        - server
    - additionalInformation: {}
      authorities: []
      authorizedGrantTypes:
        - password
        - refresh_token
        - authorization_code
        - client_credentials
        - implicit
      autoApproveScopes:
        - 'true'
      clientId: app
      clientSecret: "{noop}app"
      registeredRedirectUri: []
      resourceIds: []
      scope:
        - server
      accessTokenValiditySeconds: 86400
      refreshTokenValiditySeconds: 2592000
    - additionalInformation: {}
      authorities: []
      authorizedGrantTypes:
        - password
        - refresh_token
        - authorization_code
        - client_credentials
        - implicit
      autoApproveScopes:
        - 'true'
      clientId: test
      clientSecret: "{noop}test"
      registeredRedirectUri: []
      resourceIds: []
      scope:
        - server
      accessTokenValiditySeconds: 60
      refreshTokenValiditySeconds: 120
:2025-08-13 11:40:47.929  INFO main c.a.c.n.c.NacosConfigDataLoader: [Nacos Config] Load config[dataId=application-dev.yml, group=DEFAULT_GROUP] success
:2025-08-13 11:40:47.929 DEBUG main c.a.c.n.c.NacosConfigDataLoader: [Nacos Config] config[dataId=application-dev.yml, group=DEFAULT_GROUP] content: 
# 配置文件加密根密码
jasypt:
  encryptor:
    password: pig
    algorithm: PBEWithMD5AndDES
    iv-generator-classname: org.jasypt.iv.NoIvGenerator
    
# Spring 相关
spring:
  cache:
    type: redis
  data:
    redis:
      host: ${REDIS_HOST:192.168.0.201}
      port: 6379
      password: mphodendo9
  cloud:
    sentinel:
      eager: true
      transport:
        dashboard: pig-sentinel:5003
    openfeign:
      sentinel:
        enabled: true
      okhttp:
        enabled: true
      httpclient:
        enabled: false
      compression:
        request:
          enabled: true
        response:
          enabled: true

# 暴露监控端点
management:
  endpoints:
    web:
      exposure:
        include: "*"  
  endpoint:
    health:
      show-details: ALWAYS

# mybaits-plus配置
mybatis-plus:
  mapper-locations: classpath:/mapper/*Mapper.xml
  global-config:
    banner: false
    db-config:
      id-type: auto
      table-underline: true
      logic-delete-value: 1
      logic-not-delete-value: 0
  type-handlers-package: com.pig4cloud.pig.common.mybatis.handler
  configuration:
    map-underscore-to-camel-case: true
    shrink-whitespaces-in-sql: true

# swagger 配置
swagger:
  enabled: true
  title: Pig Swagger API
  gateway: http://${GATEWAY_HOST:pig-gateway}:${GATEWAY-PORT:9999}
  token-url: ${swagger.gateway}/auth/oauth2/token
  scope: server
  services:
    pig-upms-biz: admin
    pig-codegen: gen



